# GEMINI_API_KEY: Optional, only needed if you use Gemini AI features.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# JWT_SECRET: Required in production. Signs staff login sessions.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="change-this-to-a-long-random-string"

# PORT: Which port the Express server listens on. Defaults to 3000.
PORT=3000
